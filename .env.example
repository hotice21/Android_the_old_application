# ===== Server =====
SERVER_PORT=8080

# ===== MySQL =====
MYSQL_PORT=3306
MYSQL_DATABASE=eligo
MYSQL_USER=eligo
MYSQL_PASSWORD=change_me_mysql_password
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password

# ===== Redis =====
REDIS_PORT=6379
# Leave empty for no password
REDIS_PASSWORD=

# ===== Security Keys =====
# Generate 32-byte Base64 keys. PowerShell example:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 } | ForEach-Object { [byte]$_ }))
JWT_SIGNING_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
DATA_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
DATA_LOOKUP_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY

# ===== WeChat (optional) =====
# Fill these to enable WeChat login
WECHAT_APP_ID=
WECHAT_APP_SECRET=
