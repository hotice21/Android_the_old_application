# 本地测试配置（测试阶段）
# 跳过前端所有登录拦截；后端请用 local-dev profile 或设置 ELIGO_SECURITY_ENABLED=false
VITE_DEV_SKIP_LOGIN=true

# 后端已开启 CORS，H5 浏览器直接跨域访问 localhost:8080
# Android 模拟器访问宿主机后端用 http://10.0.2.2:8080
# 真机测试请改成电脑局域网 IP，例如 http://192.168.1.10:8080
VITE_API_BASE_URL=http://localhost:8080

VITE_PROFILE_DATA_MODE=api
