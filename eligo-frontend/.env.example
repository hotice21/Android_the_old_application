# H5 开发环境留空时，通过 Vite 将 /api 代理到 http://127.0.0.1:8080。
# 微信开发者工具默认使用 http://127.0.0.1:8080。
# 真机或测试环境必须改成已配置 HTTPS 的合法域名。
VITE_API_BASE_URL=

# 个人资料默认调用真实 API；仅制作纯视觉 demo 时显式改为 mock。
# mock 模式不会把演示资料提交到后端。
VITE_PROFILE_DATA_MODE=api

# 测试阶段开关：设为 true 后跳过前端所有登录拦截（免登录手动测试）。
# 后端需同步关闭校验：使用 local-dev profile，或设置环境变量 ELIGO_SECURITY_ENABLED=false。
# 上线前必须删除或设为 false。
VITE_DEV_SKIP_LOGIN=false
